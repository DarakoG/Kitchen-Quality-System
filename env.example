# ============================================
# Kitchen Quality System - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --------------------------------------------
# Database Configuration (Required)
# --------------------------------------------
# SQLite database file path
DATABASE_URL=file:./db/custom.db

# --------------------------------------------
# Application Configuration (Optional)
# --------------------------------------------
# Application environment: development, production, test
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# --------------------------------------------
# Security Configuration (Recommended for Production)
# --------------------------------------------
# Secret key for session/token signing
# Generate a secure random string: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-in-production

# Application URL (for production)
NEXTAUTH_URL=http://localhost:3000

# --------------------------------------------
# Default Super Admin Credentials
# --------------------------------------------
# These are set when running: bun run db:seed
# Default: admin@kqs.com / Admin123!
# You can change them in prisma/seed.ts

# --------------------------------------------
# Notes
# --------------------------------------------
# 1. For SQLite: DATABASE_URL=file:./db/custom.db
# 2. For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# 3. For MySQL: DATABASE_URL=mysql://user:password@localhost:3306/dbname
# 4. Make sure the db folder exists before running migrations

# --------------------------------------------
# Quick Start Commands
# --------------------------------------------
# 1. Copy this file: cp .env.example .env
# 2. Install dependencies: bun install
# 3. Push database schema: bun run db:push
# 4. Seed super admin: bun run db:seed
# 5. Start development: bun run dev
# 6. Login with: admin@kqs.com / Admin123!
